# Database — never commit this, it contains PII
*.db
*.sqlite
*.sqlite3

# Settings file — contains encrypted credentials
openoptout_settings.json
privacyshield_settings.json

# Environment variables
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
venv/
.venv/
env/

# Node
node_modules/
dist/
.vite/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Docker volumes
data/

# Certificates, keys, and secrets — never commit
*.pem
*.key
*.crt
*.p12
*.pfx
certs/
secrets/

# Uploaded logos / generated output
logo/
screenshots/

# Installed plugins and their runtime storage (examples/ are tracked)
/data/plugins/
/data/plugin_storage/
plugins_installed/
# Compiled gRPC stubs (generated at build time)
backend/plugins/proto/plugin_pb2.py
backend/plugins/proto/plugin_pb2_grpc.py

# Fuzzing: generated copy of the backend (fuzz/build_pkgroot.sh) and local run output
fuzz/.pkgroot/
fuzz/corpus/
fuzz/crash-*
fuzz/timeout-*
fuzz/oom-*
