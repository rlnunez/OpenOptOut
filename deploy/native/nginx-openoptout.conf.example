# OpenOptOut — nginx site config (native install, no Docker).
#
# Install (Debian/Ubuntu path shown; adjust for other distros):
#   sudo cp deploy/native/nginx-openoptout.conf.example /etc/nginx/sites-available/openoptout
#   sudo ln -s /etc/nginx/sites-available/openoptout /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Before that: edit YOUR_DOMAIN below, and confirm the `root` path matches
# where the frontend build actually landed (deploy/native/install.sh builds it
# to frontend/dist under the install directory).
#
# This starts on plain HTTP only. Run scripts/enable-https-native.sh
# afterward — it uses certbot's nginx plugin to add the TLS server block and
# the HTTP→HTTPS redirect automatically; you don't need to hand-write those.
#
# If running behind Cloudflare's proxy with Authenticated Origin Pulls (AOP):
# Copy deploy/cloudflare/origin-pull-ca.pem to /etc/ssl/certs/cloudflare-origin-pull-ca.pem
# and add these two directives to the SSL server { ... } block:
#   ssl_client_certificate /etc/ssl/certs/cloudflare-origin-pull-ca.pem;
#   ssl_verify_client on;
#
# If enforcing self-managed client certificate mTLS (Option A/B):
# Copy your client CA certificate to /etc/ssl/certs/openoptout-client-ca.pem
# and add these directives to the SSL server { ... } block:
#   ssl_client_certificate /etc/ssl/certs/openoptout-client-ca.pem;
#   ssl_verify_client on;    # use 'optional' if healthchecks/monitors do not present a client cert
#
# nginx's ssl_verify_client only checks the certificate was signed by that CA
# -- it has no revocation list of its own. Also add this inside location
# /api/ { ... } below (alongside the other proxy_set_header lines) so
# OpenOptOut can still refuse a certificate that's since been revoked
# (Settings -> Client certificates (mTLS), or scripts/openoptout-mtls.sh):
#   proxy_set_header X-Client-Cert-Serial $ssl_client_serial;

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    root /opt/openoptout/frontend/dist;
    index index.html;

    # Proxy API calls to the systemd-run uvicorn process (127.0.0.1:8000 per
    # deploy/native/openoptout-api.service — change both together if you
    # picked a different port).
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;  # nosemgrep: generic.nginx.security.request-host-used.request-host-used
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Plain HTTP for now; certbot's nginx plugin rewrites this whole server
        # block (adding the 443 block and the HTTP->HTTPS redirect) when you
        # run scripts/enable-https-native.sh, so OpenOptOut still gets an
        # accurate X-Forwarded-Proto once that's done.
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback — all client-side routes go to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # A little defense in depth; harmless if your distro's nginx already sets
    # these globally.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self';" always;
}
