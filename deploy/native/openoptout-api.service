# OpenOptOut API — systemd unit (native install, no Docker).
#
# Install:
#   sudo cp deploy/native/openoptout-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now openoptout-api
#
# This assumes deploy/native/install.sh (or the equivalent manual steps in
# docs/NATIVE_INSTALL.md) has already: created /opt/openoptout/app (the
# backend code, laid out as an importable "app" package — main.py's relative
# imports require this, exactly like the Docker image does), a venv at
# /opt/openoptout/venv, and an EnvironmentFile at /opt/openoptout/.env
# (the same keys as .env.example — SECRET_KEY, FRONTEND_URL, HTTPS_MODE/DOMAIN
# if using scripts/enable-https-native.sh, etc). Adjust the paths below if you
# installed somewhere else.
#
# Workers: 1 is the default for native single-node installs to keep in-process
# security counters (per-IP/account rate limits, login failure lockouts) and
# SSO transient state (OIDC state / SAML AuthnRequest checks) strictly consistent
# without requiring an external Redis coordinator. For multi-worker setups,
# configure external Redis/DB state stores so security state is not partitioned.

[Unit]
Description=OpenOptOut API
After=network.target
# Uncomment if using a local PostgreSQL managed by systemd too:
# After=network.target postgresql.service
# Requires=postgresql.service

[Service]
Type=simple
User=openoptout
Group=openoptout
WorkingDirectory=/opt/openoptout
EnvironmentFile=/opt/openoptout/.env
ExecStart=/opt/openoptout/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

# Hardening (safe defaults for a service that writes only to its own data dir
# and reads/writes its own settings file; loosen if your setup needs more).
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/openoptout/data /var/log/openoptout
# Plugin system sandboxing uses Linux namespaces (bubblewrap) the same way the
# Docker image does. If you enable the plugin system on a native install,
# these hardening options can conflict with what bubblewrap itself needs to
# set up — if plugins fail to start, try removing ProtectSystem/ProtectHome
# here first before troubleshooting further, and see docs/PLUGINS.md.

[Install]
WantedBy=multi-user.target
