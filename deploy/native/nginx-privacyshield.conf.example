# PrivacyShield — nginx site config (native install, no Docker).
#
# Install (Debian/Ubuntu path shown; adjust for other distros):
#   sudo cp deploy/native/nginx-privacyshield.conf.example /etc/nginx/sites-available/privacyshield
#   sudo ln -s /etc/nginx/sites-available/privacyshield /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Before that: edit YOUR_DOMAIN below, and confirm the `root` path matches
# where the frontend build actually landed (deploy/native/install.sh builds it
# to frontend/dist under the install directory).
#
# This starts on plain HTTP only. Run scripts/enable-https-native.sh
# afterward — it uses certbot's nginx plugin to add the TLS server block and
# the HTTP→HTTPS redirect automatically; you don't need to hand-write those.

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    root /opt/privacyshield/frontend/dist;
    index index.html;

    # Proxy API calls to the systemd-run uvicorn process (127.0.0.1:8000 per
    # deploy/native/privacyshield-api.service — change both together if you
    # picked a different port).
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Plain HTTP for now; certbot's nginx plugin rewrites this whole server
        # block (adding the 443 block and the HTTP->HTTPS redirect) when you
        # run scripts/enable-https-native.sh, so PrivacyShield still gets an
        # accurate X-Forwarded-Proto once that's done.
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback — all client-side routes go to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # A little defense in depth; harmless if your distro's nginx already sets
    # these globally.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
