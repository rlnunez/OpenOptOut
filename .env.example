# OpenOptOut environment configuration
# Copy to .env and fill in your values. Never commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────

# Master secret key — used for JWT signing and as fallback for encryption keys.
# Must be at least 128 characters long (128–512 characters).
#
# HOW IT IS GENERATED:
# In production, the super admin generates the master secret key directly in the
# web UI on initial setup via Settings or the critical setup banner:
#   1. Combined Images + Movement (pulls 8-12 random images, sorts/converts them,
#      then lets you wiggle your cursor or type random keys to inject human physical entropy)
#   2. Mouse & Keyboard Only (direct physical cursor/typing entropy)
#   3. Manual Entry (enter or paste your own 128+ character random key)
#
# If configuring manually in this file, generate a strong random key (>= 128 hex chars):
#   python3 -c 'import secrets; print(secrets.token_hex(secrets.randbelow(65) + 64))'
#
# SECURITY REQUIREMENT:
# Lock down this file's permissions immediately so only the service owner can read it:
#   chmod 600 .env
SECRET_KEY=change-me-to-a-long-random-string-at-least-128-characters-long

# ── Host ports (change if these collide with other local services) ────────────
# Only the HOST side is affected; containers still use 8000 (api) and 80 (web)
# internally. Default API_PORT is 8010 to avoid the very common 8000 conflict.
#API_PORT=8010
#WEB_PORT=80

# Interfaces those host ports are bound to. Default is loopback-only for the API
# (it's reached over the internal Docker network by the web UI; exposing it
# beyond this machine would let plain-HTTP requests, including sign-in, reach it
# directly). ./scripts/enable-https.sh sets WEB_BIND=127.0.0.1 + WEB_PORT=8080
# automatically so Caddy can take ports 80/443 instead — see the HTTPS section
# below and docs/HTTPS.md.
#API_BIND=127.0.0.1
#WEB_BIND=0.0.0.0

# How many proxies sit in front of the API. Sign-in limits are per client IP,
# taken from X-Forwarded-For this many entries from the right. 1 = the web
# container's nginx (default); 2 = Caddy + nginx, which ./scripts/enable-https.sh
# sets for you. Native installs (nginx in front): 1. API reached directly: 0.
#TRUSTED_PROXY_HOPS=1
# Failed sign-ins from one client IP before it is locked out for a while (high
# because a library branch's patrons can share one public address).
#LOGIN_IP_MAX_FAILURES=50

# ── Security Keys & Encryption at Rest ─────────────────────────────────────────
# All keys below are automatically generated by install.sh / setup.sh with
# non-deterministic random lengths (128..256 hex characters) and locked down with
# 0600 file permissions. If generating manually, use:
#   python3 -c 'import secrets; print(secrets.token_hex(secrets.randbelow(65) + 64))'

# SQLCipher key — encrypts the entire SQLite database file at rest with AES-256.
# If set and sqlcipher3 is installed, the DB file is AES-256 encrypted.
# NOTE: If you set this on an existing unencrypted DB, run the migration first:
#   docker exec openoptout-api python -m backend.core.encryption migrate
#DB_ENCRYPTION_KEY=

# Field-level encryption key — encrypts sensitive PII columns (names, addresses,
# phones, emails) before they reach the database. Independent of DB_ENCRYPTION_KEY.
# If not set, falls back to SECRET_KEY for key derivation.
#FIELD_ENCRYPTION_KEY=

# SearXNG session secret — used exclusively by the private SearXNG container.
# Decoupled from SECRET_KEY so SearXNG cannot access OpenOptOut's master key.
#SEARXNG_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────

# Database URL — default is SQLite. Switch to Postgres for multi-instance deployments.
# For Postgres encryption, use RDS/Azure/Cloud SQL provider-level TDE or pgcrypto.
#DATABASE_URL=postgresql://user:password@host:5432/openoptout

# If you use the bundled PostgreSQL service in docker-compose.yml (uncomment the
# `db` service there), set these and point DATABASE_URL at the `db` host, e.g.:
#   DATABASE_URL=postgresql://openoptout:${POSTGRES_PASSWORD}@db:5432/openoptout
#POSTGRES_USER=openoptout
#POSTGRES_PASSWORD=set-a-strong-password
#POSTGRES_DB=openoptout

# Path to settings JSON file (default: /data/openoptout_settings.json in Docker)
#SETTINGS_FILE=/data/openoptout_settings.json

# JWT token expiry in minutes (default: 1440 = 24 hours)
#ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend URL — the exact public address people use, including https://.
# Used to build OIDC/SAML SSO redirects; must match reality whether HTTPS comes
# from OpenOptOut's own front door or a reverse proxy you already run.
#FRONTEND_URL=https://privacy.yourdomain.org

# ── HTTPS (optional) ────────────────────────────────────────────────────────────
# See docs/HTTPS.md. Configured automatically via ./scripts/enable-https.sh (or .ps1).
# Documented here for reference.
#
# Managed front door (Caddy, Traefik, or Cloudflare Tunnel):
#COMPOSE_PROFILES=https-caddy-extended  # https-caddy-extended | https | https-traefik | cloudflare-tunnel
#FRONT_DOOR=caddy                    # caddy | traefik | cloudflare-tunnel
#HTTPS_MODE=letsencrypt              # letsencrypt | none | letsencrypt-staging | acme | incommon | internal | custom
#ACME_CHALLENGE=http                 # http (port 80) | cloudflare (DNS check, no open ports)
#CLOUDFLARE_API_TOKEN=               # Required for ACME_CHALLENGE=cloudflare (Zone > DNS > Edit)
#DOMAIN=privacy.yourdomain.org
#ACME_EMAIL=admin@yourdomain.org
#
# Flood protection, HSTS & rate limiting (Caddy/Traefik) — see docs/HTTPS.md:
#HSTS=on                             # on (default when SSL cert is installed) | off
#RATE_LIMIT=on                       # on (default) | off
#RATE_LIMIT_PER_MINUTE=1200          # Whole site rate limit per visitor
#AUTH_RATE_LIMIT_PER_MINUTE=60       # Sign-in endpoints rate limit per visitor
#CLOUDFLARE_PROXY=off                # on = accept connections only from Cloudflare IP ranges
#CLOUDFLARE_AOP=off                  # on = require Cloudflare Authenticated Origin Pull client mTLS cert
#CLOUDFLARE_AOP_CA_FILE=/deploy/origin-pull-ca.pem  # optional custom CA cert for zone-level AOP
#
# Custom ACME CA (HTTPS_MODE=acme):
#ACME_CA=https://ca.internal.example/acme/acme/directory
#ACME_CA_ROOT=/certs/acme-ca-root.pem
#
# InCommon / EAB credentials (HTTPS_MODE=incommon or acme):
#ACME_CA=https://acme-us.certinext.io/v1/directory
#ACME_EAB_KID=
#ACME_EAB_HMAC=
#ACME_KEY_TYPE=rsa2048               # rsa2048 (default for InCommon) | rsa4096 | p256 | p384
#
# Cloudflare Tunnel:
#CLOUDFLARE_TUNNEL_TOKEN=
#
# External reverse proxy: leave HTTPS_MODE/DOMAIN/COMPOSE_PROFILES unset.
# Set FRONTEND_URL above to your public https:// address and forward X-Forwarded-Proto.
#
# Internal certificate monitor target (set by enable-https.sh):
#HTTPS_CHECK_HOST=caddy              # caddy | traefik
#HTTPS_CHECK_PORT=443

# Logo storage path (default: /data/logo in Docker)
#LOGO_PATH=/data/logo

# ── Enterprise PostgreSQL connection (optional) ───────────────────────────────
# For structured connection config instead of a plain DATABASE_URL.
# Enable in the admin UI (Database → Connection) or set DB_USE_STRUCTURED_CONFIG=true.
#
# Non-secret settings (safe to set here or in the UI):
#DB_HOST=db.internal.example.org
#DB_PORT=5432
#DB_NAME=openoptout
#DB_USER=openoptout_svc
#DB_AUTH_METHOD=client_cert          # password|ssl_password|client_cert|cert_and_password|iam_aws|iam_gcp|iam_azure|gssapi
#DB_SSLMODE=verify-full              # disable|allow|prefer|require|verify-ca|verify-full
#
# Certificate/key FILE PATHS — mount these files read-only; the DBA controls them.
# The paths are non-secret; the files they point to ARE secret.
#DB_SSLROOTCERT=/certs/ca.pem
#DB_SSLCERT=/certs/client-cert.pem
#DB_SSLKEY=/certs/client-key.pem     # chmod 600, owned by the app user
#
# SECRET material — NEVER put actual passwords in this file if you can avoid it.
# Prefer Docker secrets, Kubernetes secrets, or Vault injection.
# Option A — environment variable (from a secret manager):
#DB_PASSWORD=
# Option B — Docker/K8s secret mounted as a file (preferred):
#DB_PASSWORD_FILE=/run/secrets/db_password
#
# Cloud IAM (no static password — uses short-lived tokens):
#DB_IAM_REGION=us-east-1             # AWS region or GCP/Azure equivalent

# ── Proxy / IP masking (optional) ─────────────────────────────────────────────
# Route automation traffic through proxies to mask the server IP. This is the
# single most effective bot-evasion measure. Configure mode/provider/host in the
# admin UI (Settings → Proxy); credentials live here or in mounted files only.
#
# Master switch (also toggleable in the UI):
#PROXY_ENABLED=true
#
# Generic proxy host/port (or set these in the UI):
#PROXY_HOST=gate.provider.com
#PROXY_PORT=7000
#
# Generic credentials (env var or mounted file):
#PROXY_USER=your-proxy-username
#PROXY_PASS=your-proxy-password
#PROXY_USER_FILE=/run/secrets/proxy_user
#PROXY_PASS_FILE=/run/secrets/proxy_pass
#
# Provider-specific credentials (used automatically when that provider is selected):
#BRIGHTDATA_USER=brd-customer-XXXX-zone-residential
#BRIGHTDATA_PASS=
#OXYLABS_USER=customer-XXXX-cc-us
#OXYLABS_PASS=
#SMARTPROXY_USER=
#SMARTPROXY_PASS=
#IPROYAL_USER=
#IPROYAL_PASS=
#
# Rotating pool mode — newline- or comma-separated proxy URLs (or a mounted file).
# Each entry: http://user:pass@host:port  OR  http://host:port (shared creds above)
#PROXY_POOL=http://host1:7000,http://host2:7000
#PROXY_POOL_FILE=/run/secrets/proxy_pool

# ── Plugin system (optional) ──────────────────────────────────────────────────
# Process-isolated, sandboxed plugins. Enable in Settings → Plugin system, then
# restart. Full OS sandboxing requires Linux + bubblewrap (installed in the
# provided Dockerfile). See docs/PLUGINS.md.
#PLUGINS_DIR=/data/plugins
#PLUGIN_STORAGE_DIR=/data/plugin_storage
